{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://claude-team/schemas/gate-result.json",
  "title": "GateResultPayload",
  "description": "Message payload for quality gate pass/fail decisions",
  "type": "object",
  "required": ["gateType", "verdict", "score", "taskId", "feedback"],
  "properties": {
    "gateType": {
      "type": "string",
      "description": "Type of quality gate that was evaluated"
    },
    "verdict": {
      "type": "string",
      "description": "Gate decision outcome",
      "enum": ["pass", "conditional", "reject", "auto-reject"]
    },
    "score": {
      "type": "number",
      "description": "Overall gate score",
      "minimum": 0,
      "maximum": 10
    },
    "taskId": {
      "type": "string",
      "description": "Unique identifier for the task that went through the gate"
    },
    "feedback": {
      "type": "string",
      "description": "Detailed feedback from the gate evaluation"
    }
  },
  "additionalProperties": false
}
